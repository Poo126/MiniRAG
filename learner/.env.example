export OPENAI_BASE_URL="https://openai.vocareum.com/v1"

# Qdrant Cloud free tier (recommended):
#   https://cloud.qdrant.io/ → create cluster → copy URL + API key
export QDRANT_URL="https://e11bb04f-664f-4b4a-b643-e3d5cecc4ce4.us-east-1-1.aws.cloud.qdrant.io:6333"
