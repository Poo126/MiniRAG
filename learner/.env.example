##########
USE_HYBRID_SEARCH=true
# ─── Local Qdrant alternative ─────────────────────────────────
# If you'd rather run Qdrant locally via Docker:
#     docker run -p 6333:6333 -v $(pwd)/qdrant_storage:/qdrant/storage qdrant/qdrant
# then use:
#     export QDRANT_URL="http://localhost:6333"
#     unset QDRANT_API_KEY

# Optional W9 stretch path. Leave both disabled for dense-only retrieval.
export USE_HYBRID_SEARCH="0"
export USE_RERANK="0"
export RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
export HYBRID_CANDIDATE_K="20"
